      },
      "doc_targets": [
        "docs/design/architecture/data/service-inventory.json"
      ],
      "rationale": "OpenClaw cron config drift implies service-inventory.json fields (timeout_seconds, delivery, schedule) may need updating. Class includes Felix self-modifications (see #273).",
