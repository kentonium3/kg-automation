{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentonium3/kg-automation/docs/design/standards/frontmatter.schema.json",
  "title": "kg-automation Documentation Frontmatter Schema",
  "description": "Canon v3 schema — lightweight frontmatter for kg-automation docs",
  "type": "object",
  "required": [
    "title",
    "doc_type",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([-.][a-z0-9]+)*$",
      "description": "Optional kebab-case identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable title"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "strategy",
        "charter",
        "decision",
        "policy",
        "handbook",
        "runbook",
        "guide",
        "reference",
        "readme",
        "index",
        "project",
        "note"
      ],
      "description": "Document type classification"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "deprecated",
        "archived"
      ],
      "description": "Document lifecycle status"
    },
    "level": {
      "type": "string",
      "enum": [
        "overview",
        "concept",
        "howto",
        "reference",
        "policy"
      ],
      "description": "Optional documentation level/depth"
    },
    "audience": {
      "type": "string",
      "enum": [
        "agents",
        "humans",
        "agents_and_humans"
      ],
      "description": "Optional target audience"
    },
    "owners": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Optional list of document owners"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Optional last update date (YYYY-MM-DD)"
    },
    "revision": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$",
      "description": "Optional version in vMAJOR.MINOR format"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional tags for categorization"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional alternative names"
    },
    "links": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional related links"
    }
  },
  "additionalProperties": true
}
