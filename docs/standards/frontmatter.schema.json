{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentonium3/kg-automation/docs/standards/frontmatter.schema.json",
  "title": "kg-automation Documentation Frontmatter Schema",
  "description": "Canon v2 schema for documentation frontmatter in kg-automation",
  "type": "object",
  "required": [
    "id",
    "title",
    "doc_type",
    "level",
    "status",
    "owners",
    "last_updated",
    "revision",
    "audience"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique identifier in kebab-case"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable title"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "strategy",
        "charter",
        "decision",
        "policy",
        "handbook",
        "runbook",
        "guide",
        "reference",
        "readme",
        "index",
        "project",
        "note"
      ],
      "description": "Document type classification"
    },
    "level": {
      "type": "string",
      "enum": [
        "overview",
        "concept",
        "howto",
        "reference",
        "policy"
      ],
      "description": "Documentation level/depth"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "deprecated",
        "archived"
      ],
      "description": "Document lifecycle status"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "List of document owners (GitHub handles or names)"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Last update date in ISO format (YYYY-MM-DD)"
    },
    "revision": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$",
      "description": "Version number in vMAJOR.MINOR format"
    },
    "audience": {
      "type": "string",
      "enum": [
        "agents",
        "humans",
        "agents_and_humans"
      ],
      "description": "Target audience for the document"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional tags for categorization"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional alternative names/identifiers"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional related links"
    }
  },
  "additionalProperties": false
}
