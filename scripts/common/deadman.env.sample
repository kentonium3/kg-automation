# Off-host dead-man ping URLs (#1077). TEMPLATE ONLY — never commit real values.
#
# Real file: /home/claude/.config/felix/deadman/env  (claude:claude, mode 0600)
# Read only by scripts/common/deadman.py; never loaded into a process environment.
# Each URL is a capability secret: anyone holding it can mark the check "up".
#
# Provision from your own terminal without echoing the values:
#   ssh -t office2-claude 'umask 077; mkdir -p ~/.config/felix/deadman; read -rsp "canary ping URL: " C; echo; read -rsp "health-check ping URL: " H; echo; printf "FELIX_DEADMAN_CANARY_URL=%s\nFELIX_DEADMAN_HEALTHCHECK_URL=%s\n" "$C" "$H" > ~/.config/felix/deadman/env'
FELIX_DEADMAN_CANARY_URL=https://hc-ping.com/<uuid>
FELIX_DEADMAN_HEALTHCHECK_URL=https://hc-ping.com/<uuid>
