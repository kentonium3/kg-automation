[Unit]
Description=Felix pull-based deploy applier (oneshot)
Documentation=https://github.com/kentonium3/kg-automation/blob/main/docs/runbooks/deploy/discipline.md

[Service]
Type=oneshot
WorkingDirectory=/home/claude/kg-automation
# File-path invocation: the felix-deployer/ directory name contains a
# hyphen so it is not importable as a Python module. The deployer.py
# bootstrap inserts the repo root and the felix-deployer directory
# itself onto sys.path so scripts.deploy.lib and the sibling notify
# module both resolve.
ExecStart=/usr/bin/python3 /home/claude/kg-automation/scripts/deploy/felix-deployer/deployer.py
Environment=PATH=/home/claude/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Load FELIX_DEPLOYER_NTFY_TOPIC for notify.py's ntfy.sh dispatch (see
# scripts/deploy/felix-deployer/env.sample and
# kitty-specs/felix-deployer-ntfy-failure-notifications-01KTZ76F/contracts/ntfy-notification-v1.md).
# Leading `-` makes the directive non-fatal if the env file is missing —
# graceful onboarding before the operator provisions the topic.
EnvironmentFile=-/home/claude/.config/felix-deployer/env
# Load FELIX_ALERT_NTFY_TOPIC for the unified felix-alert bus
# (scripts/common/alert_bus/). Credential: felix-alert-ntfy-topic; template
# scripts/common/alert_bus.env.sample. Leading `-` keeps startup non-fatal if
# the operator has not yet provisioned the topic (the bus then returns
# NTFY_MISSING_TOPIC rather than crashing the emitter).
EnvironmentFile=-/home/claude/.config/felix/alert-bus/env
StandardOutput=journal
StandardError=journal
