[Unit]
Description=credential-health-check — process credential cadence + activity signals
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=10min
ExecStart=/usr/bin/python3 -m scripts.security.credential_health_check --manifest /home/claude/kg-automation/docs/design/architecture/data/credential-manifest.json
Environment=HOME=/home/claude
Environment=PYTHONPATH=/home/claude/kg-automation
WorkingDirectory=/home/claude/kg-automation
