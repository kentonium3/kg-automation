[Unit]
Description=felix-trust-scan — cron-drift + completion-assertion scan (<=15min cadence)

# No Persistent= here: on a monotonic timer it makes the timer go permanently
# dormant after a slow boot (#1062). tests/tooling/test_timer_persistent_guard.py
[Timer]
OnBootSec=5min
OnUnitActiveSec=15min

[Install]
WantedBy=timers.target
