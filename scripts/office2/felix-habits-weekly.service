[Unit]
Description=felix-habits-weekly — deterministic weekly habit-report driver (no-LLM producer, #723)
After=network-online.target
Wants=network-online.target
# A runner-level failure (non-zero exit) triggers an out-of-band ERROR alert
# independent of the driver's own tick/logging — mirrors felix-canary's
# SC-006 precedent (scripts/office2/felix-canary.service).
OnFailure=felix-habits-weekly-onfailure.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -m scripts.habits.weekly_report_driver
Environment=HOME=/home/claude
Environment=PYTHONPATH=/home/claude/kg-automation
WorkingDirectory=/home/claude/kg-automation
TimeoutStartSec=120
# Load FELIX_ALERT_NTFY_TOPIC for the unified felix-alert bus
# (scripts/common/alert_bus/). Credential: felix-alert-ntfy-topic; template
# scripts/common/alert_bus.env.sample. Leading "-" keeps startup non-fatal if
# the topic env-file is absent (the bus returns NTFY_MISSING_TOPIC instead of
# failing the run).
EnvironmentFile=-/home/claude/.config/felix/alert-bus/env
