[Unit]
Description=Felix Heartbeat Gate — Haiku-tier routing for OpenClaw heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/data/services/openclaw/felix-heartbeat-gate/venv/bin/python /home/claude/kg-automation/scripts/openclaw/heartbeat_gate/run.py
Environment=HOME=/home/claude
WorkingDirectory=/home/claude/kg-automation
