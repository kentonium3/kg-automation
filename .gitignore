# Claude Code local settings
.claude/settings.local.json

# Obsidian (shared config allowed, volatile state ignored)
docs/.obsidian/*
!docs/.obsidian/plugins/
!docs/.obsidian/plugins/templater-obsidian/
!docs/.obsidian/plugins/templater-obsidian/data.json
docs/.obsidian/workspace.json
docs/.obsidian/graph.json
docs/.obsidian/workspace-mobile.json

# Common plugin caches (safe to expand later)
docs/.obsidian/plugins/**/cache/
docs/.obsidian/plugins/**/.cache/

# Note: docs/.obsidian-shared/ is tracked (contains hotkeys.example.json)
.DS_Store

# VS Code workspace state (local editor preference)
.vscode/tasks.json
__pycache__/
# Temporary prompt files and scratch
temp/

.kittify/derived/
.kittify/runtime/
.kittify/.migration-backup/
.kittify/cache/
.kittify/missions/
.kittify/scripts/

# Agent sandbox residue (Codex, etc.)
.codex-tmp-home/
.tmp-home/

# Spec-kitty worktree state
.claude/worktrees/
