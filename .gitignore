# Claude Code local settings
.claude/settings.local.json

# Antigravity (agy) CLI machine-local project marker
.antigravitycli/

# Obsidian (shared config allowed, volatile state ignored)
docs/.obsidian/*
!docs/.obsidian/plugins/
!docs/.obsidian/plugins/templater-obsidian/
!docs/.obsidian/plugins/templater-obsidian/data.json
docs/.obsidian/workspace.json
docs/.obsidian/graph.json
docs/.obsidian/workspace-mobile.json

# Common plugin caches (safe to expand later)
docs/.obsidian/plugins/**/cache/
docs/.obsidian/plugins/**/.cache/

# Note: docs/.obsidian-shared/ is tracked (contains hotkeys.example.json)
.DS_Store

# VS Code workspace state (local editor preference)
.vscode/tasks.json
__pycache__/
# Temporary prompt files and scratch
temp/

.kittify/derived/
.kittify/runtime/
.kittify/.migration-backup/
.kittify/cache/
.kittify/missions/
.kittify/scripts/

# Spec-kitty local-runtime state (flagged by `spec-kitty doctor state-roots`
# as "Risk: accidental commit"). Authority is local_runtime or derived — these
# should never be committed.
.kittify/workspaces/
.kittify/.dashboard
.kittify/charter/context-state.json
.kittify/charter/references.yaml
.kittify/charter/governance.yaml
.kittify/charter/directives.yaml
.kittify/charter/metadata.yaml

# Agent sandbox residue (Codex, etc.)
.codex-tmp-home/
.tmp-home/

# Spec-kitty worktree state
.claude/worktrees/

# pytest coverage artifacts
.coverage
.coverage.*
htmlcov/

# Added by Spec Kitty CLI (auto-managed)
.kittify/sync-state.json
