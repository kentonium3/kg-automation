{
  "files.eol": "\n",
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": true
  },
  "markdownlint.config": {
    "MD013": false,
    "MD022": false,
    "MD025": false,
    "MD032": false,
    "MD034": false
  },
  "python.defaultInterpreterPath": "/usr/local/bin/python3",

  // Exclude spec-kitty worktrees from file watching to prevent FSEvents
  // overflow during worktree removal, which crashes VS Code (SIGTERM).
  // See docs/diagnostics/spec-kitty-feedback/merge-crash-incomplete-cleanup.md
  "files.watcherExclude": {
    "**/.worktrees/**": true
  }
}
