{
  "files.eol": "\n",

  // Disable markdown auto-formatting on save to reduce FSEvents load during
  // git operations. Linting still runs (warnings shown) but does not
  // auto-modify files, preventing the feedback loop of:
  //   git operation → file change → linter auto-fix → more file changes
  // See docs/diagnostics/spec-kitty-feedback/merge-crash-incomplete-cleanup.md
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": true,
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },
  "markdownlint.config": {
    "MD013": false,
    "MD022": false,
    "MD025": false,
    "MD032": false,
    "MD034": false
  },
  "markdownlint.run": "onSave",

  // Repo-relative so it resolves on every machine (Mac and office4 alike).
  // A hardcoded absolute path here was a macOS-only Homebrew path and failed
  // to resolve on Linux.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Exclude spec-kitty worktrees from file watching to prevent FSEvents
  // overflow during worktree removal, which crashes VS Code (SIGTERM).
  // See docs/diagnostics/spec-kitty-feedback/merge-crash-incomplete-cleanup.md
  "files.watcherExclude": {
    "**/.worktrees/**": true
  }
}
