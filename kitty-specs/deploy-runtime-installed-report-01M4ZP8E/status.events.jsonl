{"aggregate_id": "01M4ZP8E6RNPVSBPZ0SQCZ0SVR", "aggregate_type": "Mission", "event_id": "01M4ZP8E8EHF1E6PD81DBK91PK", "event_type": "MissionCreated", "payload": {"actor": "kentgale@gmail.com", "created_at": "2026-10-15T11:48:15.226635+00:00", "friendly_name": "Deploys report what they installed so the rebaseline expects it", "mission_id": "01M4ZP8E6RNPVSBPZ0SQCZ0SVR", "mission_number": null, "mission_slug": "deploy-runtime-installed-report-01M4ZP8E", "mission_type": "software-dev", "purpose_context": "felix-deployer decides which security-monitor baselines a deploy will change from the files changed in git, but drift comes from what was installed on the host. A deploy that re-installs files committed earlier ends in a false 'unexpected drift' alert unless its author remembered to declare it, and two of 32 deploys did not. The deploy library will report the repo files it installed, and the deployer will map them to baselines automatically. Tracks kentonium3/kg-automation#1072.", "purpose_tldr": "Stop false 'unexpected drift' security alerts after intended deploys by having deploys report the files they actually installed, so the security rebaseline expects exactly that drift.", "target_branch": "fix/deploy-runtime-installed-report", "wp_count": 0}, "project_slug": "kg-automation", "project_uuid": "2c011d09-8272-470c-b9e2-e9ccf8ad3fbd", "schema_version": "5.0.0", "timestamp": "2026-10-15T11:48:15.246518+00:00"}
