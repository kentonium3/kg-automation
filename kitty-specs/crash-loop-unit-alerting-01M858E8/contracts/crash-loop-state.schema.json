{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kg-automation/crash-loop-state.schema.json",
  "title": "felix-canary crash-loop state (/data/services/felix-canary/state/crash-loop.json)",
  "type": "object",
  "required": ["schema_version", "units"],
  "properties": {
    "schema_version": {"const": 1},
    "units": {
      "type": "object",
      "propertyNames": {"pattern": "^(system|user|container):.+$"},
      "additionalProperties": {
        "type": "object",
        "required": ["history", "episode"],
        "properties": {
          "history": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {"type": "array", "prefixItems": [{"type": "string", "format": "date-time"}, {"type": "integer", "minimum": 0}], "minItems": 2, "maxItems": 2}
          },
          "episode": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "required": ["started_utc", "last_alert_utc", "quiet_ticks", "peak_delta"],
               "properties": {
                 "started_utc": {"type": "string", "format": "date-time"},
                 "last_alert_utc": {"type": "string", "format": "date-time"},
                 "quiet_ticks": {"type": "integer", "minimum": 0},
                 "peak_delta": {"type": "integer", "minimum": 0}
               }}
            ]
          }
        }
      }
    }
  },
  "description": "Load is fail-safe: missing, corrupt, non-object, or unknown schema_version loads as empty (every unit first-seen, no alert). A malformed per-unit entry is dropped individually."
}
