{"aggregate_id": "01M502K3RQEMBXJCS2B480KC5Z", "aggregate_type": "Mission", "event_id": "01M502K3V3WWD0CMW075T6ZSJN", "event_type": "MissionCreated", "payload": {"actor": "kentgale@gmail.com", "created_at": "2026-10-15T15:23:47.903599+00:00", "friendly_name": "Backup alerts name why the run failed", "mission_id": "01M502K3RQEMBXJCS2B480KC5Z", "mission_number": null, "mission_slug": "backup-failure-cause-in-alert-01M502K3", "mission_type": "software-dev", "purpose_context": "Since #1063 the canary pages within about 15 minutes of a failed 04:00 backup, but the alert names a pointer key such as restic_exit_code=127, not the cause. backup.sh will record a failure_reason code in its state pointer, declared diagnostic-only in the key_ledger, and the canary and health-check alerts will include it without it ever affecting health. Root never runs claude-writable code. Tracks kentonium3/kg-automation#1067.", "purpose_tldr": "When the nightly backup fails, the canary's alert should say why (for example, the backup drive is not mounted) instead of naming a pointer key.", "target_branch": "fix/backup-failure-cause-in-alert", "wp_count": 0}, "project_slug": "kg-automation", "project_uuid": "2c011d09-8272-470c-b9e2-e9ccf8ad3fbd", "schema_version": "5.0.0", "timestamp": "2026-10-15T15:23:47.939846+00:00"}
