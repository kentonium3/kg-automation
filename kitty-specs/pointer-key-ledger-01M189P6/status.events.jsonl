{"aggregate_id": "01M189P6KMJPHQ4ZPPNR25MGR8", "aggregate_type": "Mission", "event_id": "01M189P7H1QYFFN1KM9XAXF8PA", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-30T02:58:57.269166+00:00", "friendly_name": "Backup Pointer Key Ledger", "mission_id": "01M189P6KMJPHQ4ZPPNR25MGR8", "mission_number": null, "mission_slug": "pointer-key-ledger-01M189P6", "mission_type": "software-dev", "purpose_context": "The nightly backup records ten facts about each run, including the weekly integrity verdict from restic check. Six of those ten are written and then ignored by every health surface that exists, so a backup whose repository has been proven corrupt still reports healthy and nobody is told until a restore is attempted and fails. This mission replaces the habit of remembering to read each new field with a contract: every field a backup emits must be declared either as one that decides health, with an explicit definition of good, or as one kept only for diagnosis. A test reads the fields the backup actually emits and fails if any of them is undeclared. The same contract is built once and used by both machines that run backups, so the rule cannot drift apart between them.", "purpose_tldr": "Make every field a backup writes about its own health actually get read, so a repository proven corrupt can never report healthy.", "target_branch": "feat/934-pointer-key-ledger", "wp_count": 0}, "project_slug": "kg-automation", "project_uuid": "2c011d09-8272-470c-b9e2-e9ccf8ad3fbd", "schema_version": "5.0.0", "timestamp": "2026-08-30T02:58:58.209296+00:00"}
