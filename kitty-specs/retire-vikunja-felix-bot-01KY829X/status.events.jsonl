{"aggregate_id": "01KY829X6MB5XNGNSH914VPM4D", "aggregate_type": "Mission", "event_id": "01KY82A506NGEFM5304H6JY9PE", "event_type": "MissionCreated", "payload": {"created_at": "2026-07-23T18:02:48.918260+00:00", "friendly_name": "Retire Vikunja felix-bot: single kent-token model", "mission_id": "01KY829X6MB5XNGNSH914VPM4D", "mission_number": null, "mission_slug": "retire-vikunja-felix-bot-01KY829X", "mission_type": "software-dev", "purpose_context": "Felix's runtime defaults to the felix-bot Vikunja token, which cannot see the topic-projects #717 created as kent (projects 16-20, ~30+ tasks) and never shared, so scans and the dedup precheck operate on a partial view. This mission drops the agent-attribution two-token model, switches all runtime consumers to the kent token via the single client default, collapses the registry/validator to one token, records the decision in ADR-0003, and retires the felix-bot credential from the manifest (leaving the token valid for rollback and the felix-bot user dormant), deploying with before/after connectivity verification.", "purpose_tldr": "Retire the Vikunja felix-bot token and route all Felix to Vikunja access through the single kent token, so Felix sees Kent's full task store.", "target_branch": "fix/860-retire-vikunja-felix-bot", "wp_count": 0}, "project_slug": "kg-automation", "project_uuid": "2c011d09-8272-470c-b9e2-e9ccf8ad3fbd", "schema_version": "5.0.0", "timestamp": "2026-07-23T18:02:56.902916+00:00"}
