{"aggregate_id": "01M4XVY3X2ATXJASSYZ7JAJWX5", "aggregate_type": "Mission", "event_id": "01M4XVY3YY4GMR1GQ5D3JB40T7", "event_type": "MissionCreated", "payload": {"actor": "kentgale@gmail.com", "created_at": "2026-10-14T18:48:59.591761+00:00", "friendly_name": "Canary dead-man's switch and backup coverage in felix-health-check", "mission_id": "01M4XVY3X2ATXJASSYZ7JAJWX5", "mission_number": null, "mission_slug": "canary-deadman-backup-coverage-01M4XVY3", "mission_type": "software-dev", "purpose_context": "From 2026-09-27 to 2026-10-14 every nightly backup failed and nothing alerted: the canary, the only watcher of backup freshness, had stopped running, and the independent health check reported healthy 34 times because it never looked at backups or at the canary. This mission gives the health check a dead-man's switch on the canary and a second, independent backup-freshness check using the canary's own predicate, and brings the health-check script under version control. Tracks kentonium3/kg-automation#1063.", "purpose_tldr": "Make the twice-daily health check alert when the canary goes dark or backups stop, so a silent 17-day backup outage cannot recur.", "target_branch": "fix/canary-deadman-backup-coverage", "wp_count": 0}, "project_slug": "kg-automation", "project_uuid": "2c011d09-8272-470c-b9e2-e9ccf8ad3fbd", "schema_version": "5.0.0", "timestamp": "2026-10-14T18:48:59.614877+00:00"}
