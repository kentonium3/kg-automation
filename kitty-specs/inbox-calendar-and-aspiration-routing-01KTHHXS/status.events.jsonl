{"aggregate_id": "01KTHHXSAP609CQYPJ490JV1NJ", "aggregate_type": "Mission", "event_id": "01KTHHXSFDB2Q6KN9EZRJ1ZKTG", "event_type": "MissionCreated", "payload": {"created_at": "2026-06-07T17:26:11.543935+00:00", "friendly_name": "Inbox calendar and aspiration routing", "mission_id": "01KTHHXSAP609CQYPJ490JV1NJ", "mission_number": null, "mission_slug": "inbox-calendar-and-aspiration-routing-01KTHHXS", "mission_type": "software-dev", "purpose_context": "When Kent submits items via WhatsApp or Obsidian inbox, the capture agent currently flattens everything into Vikunja todos \u2014 including calendar events that should be on Google Calendar, and aspirations/musings that should be journal entries. This mission adds explicit routing for calendar events (auto-scheduled via gog when complete; WhatsApp clarification loop when incomplete), routes aspirations to dated journal entries, and adds a Vikunja Someday destination for concrete-but-parked items. It also tightens the task rule so events and aspirations stop falling through it. This is a scoped slice of the #271 Felix-as-mirror epic and supersedes #324.", "purpose_tldr": "Stop the capture agent from creating useless Vikunja todos for calendar events and aspirations; route them to Google Calendar or the journal instead.", "target_branch": "main", "wp_count": 0}, "project_slug": "kg-automation", "project_uuid": "2c011d09-8272-470c-b9e2-e9ccf8ad3fbd", "schema_version": "5.0.0", "timestamp": "2026-06-07T17:26:11.693150+00:00"}
