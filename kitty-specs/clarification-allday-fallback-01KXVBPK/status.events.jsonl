{"aggregate_id": "01KXVBPKCTH8J2Q6QKER9PGB0J", "aggregate_type": "Mission", "event_id": "01KXVBPVEYVKP7DWKXM7DX07H5", "event_type": "MissionCreated", "payload": {"created_at": "2026-07-18T19:36:54.429784+00:00", "friendly_name": "All-Day Fallback for Unanswered Clarifications", "mission_id": "01KXVBPKCTH8J2Q6QKER9PGB0J", "mission_number": null, "mission_slug": "clarification-allday-fallback-01KXVBPK", "mission_type": "software-dev", "purpose_context": "The #739 policy asks Kent for a missing appointment start-time and, per option (iii), should fall back to an all-day event if unanswered. Today the 24h clarification sweep just drops the pending record, so the appointment is re-asked every window but never scheduled. This mission adds a deterministic age-out to create-all-day fallback, scoped strictly to start-time-missing clarifications, reusing the already-shipped all-day calendar-helper support (#786) and the #746 route_and_finalize transaction for idempotent, atomic scheduling.", "purpose_tldr": "When a no-time appointment's start-time clarification goes unanswered for 24h, land it on the calendar as an all-day event instead of re-asking forever.", "target_branch": "feat/clarification-allday-fallback", "wp_count": 0}, "project_slug": "kg-automation", "project_uuid": "2c011d09-8272-470c-b9e2-e9ccf8ad3fbd", "schema_version": "5.0.0", "timestamp": "2026-07-18T19:37:02.686884+00:00"}
