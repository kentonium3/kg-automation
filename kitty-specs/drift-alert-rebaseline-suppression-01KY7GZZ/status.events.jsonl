{"aggregate_id": "01KY7GZZRKFSYWC72YABXGM3GQ", "aggregate_type": "Mission", "event_id": "01KY7H09RHJQ4AVM85YG667VR4", "event_type": "MissionCreated", "payload": {"created_at": "2026-07-23T13:00:18.070259+00:00", "friendly_name": "Suppress expected drift alerts during rebaseline", "mission_id": "01KY7GZZRKFSYWC72YABXGM3GQ", "mission_number": null, "mission_slug": "drift-alert-rebaseline-suppression-01KY7GZZ", "mission_type": "software-dev", "purpose_context": "When an audited-surface deploy lands seconds before a security-monitor audit tick, the audit sees the expected drift and fires a false error page before felix-deployer's deferred-confirm rebaseline stamps the new baseline. This mission makes the audit consult felix-deployer's pending-rebaseline token so it suppresses or downgrades alerts only for the exact baselines with expected in-flight drift, bounded by the pending window, while still paging immediately on genuinely unexpected drift, preserving the drift channel's credibility.", "purpose_tldr": "Stop the security-monitor drift audit from paging on deploy drift that felix-deployer has already flagged as expected and is actively rebaselining.", "target_branch": "fix/862-drift-alert-rebaseline-suppression", "wp_count": 0}, "project_slug": "kg-automation", "project_uuid": "2c011d09-8272-470c-b9e2-e9ccf8ad3fbd", "schema_version": "5.0.0", "timestamp": "2026-07-23T13:00:28.305847+00:00"}
