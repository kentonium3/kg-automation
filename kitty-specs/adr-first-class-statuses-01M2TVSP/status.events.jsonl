{"aggregate_id": "01M2TVSPCJ6PR4N5ZMW7PYQ17N", "aggregate_type": "Mission", "event_id": "01M2TVSPDKJDFX1GC1J1M6BF6V", "event_type": "MissionCreated", "payload": {"actor": "kentgale@gmail.com", "created_at": "2026-09-18T18:17:27.721744+00:00", "friendly_name": "ADRs as first-class docs: lifecycle-mapped statuses and a generated status taxonomy", "mission_id": "01M2TVSPCJ6PR4N5ZMW7PYQ17N", "mission_number": null, "mission_slug": "adr-first-class-statuses-01M2TVSP", "mission_type": "software-dev", "purpose_context": "Drafting ADR-0009 was rejected by the pre-commit validator for a status the ADR README itself documents as valid. Investigation found three files enumerating doc status with only one enforced (two had already drifted), a fourth divergent set in the ADR README, and ADR lifecycle states \u2014 superseded, partially superseded, has-erratum \u2014 that the taxonomy cannot express and that are currently smuggled into prose in a separate index file. Kent ruled 2026-09-18 that ADRs are now first-class persistent-memory and coordination artifacts and need statuses matching their lifecycle. Tracked as kentonium3/kg-automation#987.", "purpose_tldr": "Give ADRs a status set that maps to their real lifecycle, scope status values by doc_type, and generate the unenforced status copies from the one enforced source so the taxonomy cannot drift.", "target_branch": "feat/adr-first-class-statuses", "wp_count": 0}, "project_slug": "kg-automation", "project_uuid": "2c011d09-8272-470c-b9e2-e9ccf8ad3fbd", "schema_version": "5.0.0", "timestamp": "2026-09-18T18:17:27.731140+00:00"}
