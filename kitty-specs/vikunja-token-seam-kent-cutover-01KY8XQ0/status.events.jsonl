{"aggregate_id": "01KY8XQ0VGARKZ0V9WKV1WQ6DV", "aggregate_type": "Mission", "event_id": "01KY8XQ99N8K66DQRHQ1AZ1X4J", "event_type": "MissionCreated", "payload": {"created_at": "2026-07-24T02:01:50.196194+00:00", "friendly_name": "Vikunja token seam + kent cutover (phase 2)", "mission_id": "01KY8XQ0VGARKZ0V9WKV1WQ6DV", "mission_number": null, "mission_slug": "vikunja-token-seam-kent-cutover-01KY8XQ0", "mission_type": "software-dev", "purpose_context": "Phase 1 routed all Vikunja consumers through VikunjaClient but left token resolution split across the client default, per-habits-script constants, and sync, so the identity flip is not the one-liner it was meant to be. Phase 2 finishes the seam with a single get_vikunja_token_path() resolution point, performs the atomic flip to the kent token, retires the felix-bot Vikunja credential from the runtime path (user left dormant), reconciles the ADR/identity/credential docs and SKILL/TOOLS, and runs the attended Tier-2 cutover on office2. Resolves #831 and #750 under Epic #531.", "purpose_tldr": "Collapse Felix->Vikunja token resolution to one point, then flip felix-bot->kent and retire the felix-bot runtime token.", "target_branch": "feat/vikunja-token-seam-kent-cutover", "wp_count": 0}, "project_slug": "kg-automation", "project_uuid": "2c011d09-8272-470c-b9e2-e9ccf8ad3fbd", "schema_version": "5.0.0", "timestamp": "2026-07-24T02:01:58.837507+00:00"}
