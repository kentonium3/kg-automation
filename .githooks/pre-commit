#!/usr/bin/env bash
# Pre-commit hook: run the Docs CI validators locally so a doc-validation
# problem is caught at commit time — closest to authoring — instead of
# reddening Docs CI on main after the push.
#
# Rationale (#678, cf. #560): validate_docs.py & siblings only run in Docs CI,
# post-push. So an unknown doc_type/status enum value (or any doc-validation
# failure) turns main red for everyone until it is hand-patched. Moving the
# catch to commit time removes that churn: the bad frontmatter never enters a
# commit.
#
# All three validators run on EVERY commit (~4s total, measured 2026-07-08;
# the generated-file freshness check added 2026-09-18 is negligible).
# validate_docs.py used to run ONLY when the commit staged docs/markdown, but
# because it is a WHOLE-TREE scan while its trigger was per-commit, a frontmatter
# issue already sitting in the tree (introduced via --no-verify, an inactive
# hook, or a spec-kitty-driven commit) slipped past a later code-only commit and
# reddened Docs CI on push — the pre-commit ↔ Docs-CI trigger gap. Running it
# unconditionally re-checks the whole tree every commit and closes that gap.
#
# Active only when hooks are enabled for this clone:
#   git config core.hooksPath .githooks
# (See docs/runbooks/local-test-gate.md for setup + bypass policy.)
#
# KNOWN LIMITATION (accepted, #987): every check here validates the WORKING
# TREE, not the staged snapshot. With partial staging you can therefore commit
# a stale generated file that the hook did not see. This is the hook's existing
# whole-tree design — validate_docs.py has always worked this way, deliberately,
# to catch problems already sitting in the tree — and the freshness check simply
# matches it rather than introducing a second model. CI validates the pushed
# result, so the gap defers a failure; it does not create one.
#
# Bypass with `git commit --no-verify` in genuine emergencies — Docs CI still
# gates on main.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
# Re-read the root in the shell's own path form. On Windows (Git for Windows /
# MSYS bash) `git rev-parse --show-toplevel` prints `C:/Users/...` while `pwd`
# prints `/c/Users/...`, so comparing the two below would report every main
# checkout as a linked worktree. On Linux/macOS this is a no-op.
REPO_ROOT="$(pwd)"

# In a LINKED WORKTREE (spec-kitty lane worktrees, `git worktree add`), REPO_ROOT
# is the worktree's own root, which has no .venv — virtualenvs are not
# per-worktree. The venv lives in the main checkout: the parent of the shared git
# dir. Resolved at script scope so both the candidate list and the failure message
# can use it.
MAIN_CHECKOUT=""
_common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [[ -n "$_common_dir" ]]; then
  _parent="$(cd "$(dirname "$_common_dir")" 2>/dev/null && pwd || true)"
  if [[ -n "$_parent" && "$_parent" != "$REPO_ROOT" ]]; then
    MAIN_CHECKOUT="$_parent"
  fi
fi

# Resolve an interpreter that can actually RUN the validators (#935).
#
# `validate_docs.py` needs PyYAML; `validate_architecture_data.py` is stdlib-only.
# The system `python3` carries PyYAML on some machines and not others — office4's
# does not — so hardcoding `python3` made this hook pass on one dev machine and
# abort EVERY commit on another, including the commits spec-kitty makes internally.
#
# Order: an explicit $PYTHON override, then the repo's own venv (the environment
# this repo declares for itself), then the system interpreter. The first candidate
# that can import the validators' dependency wins, so the hook is self-healing
# rather than dependent on any one machine's site-packages. `.venv` is untracked
# and may be absent; a missing candidate is skipped, never fatal.
#
# Generalisation worth keeping: an absolute interpreter path baked into checked-in
# repo config is a latent single-machine assumption. `.vscode/settings.json` had
# the same defect (d6eddb9d) — prefer resolution over assertion.
#
# Windows (Git for Windows): a venv's interpreter is `.venv/Scripts/python.exe`,
# not `.venv/bin/python`; and the python.org installer ships `python.exe` and the
# `py` launcher but no `python3.exe` — a `python3` alias in an interactive
# ~/.bashrc is invisible to this non-interactive hook. Without these candidates
# no interpreter resolves there, and every commit aborts.
# `python` and `py` are accepted only if they are Python 3 (a legacy `python`
# can still be 2.x on old Linux images), which the probe below enforces.
SYSTEM_PYTHONS=(python3 python py)

resolve_python() {
  local candidates=()
  if [[ -n "${PYTHON:-}" ]]; then
    candidates+=("$PYTHON")
  fi
  candidates+=("$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/.venv/Scripts/python.exe")
  # Without this, the hook finds no usable interpreter from any worktree and
  # blocks every commit made there — which is every work-package commit in a
  # spec-kitty mission.
  if [[ -n "$MAIN_CHECKOUT" ]]; then
    candidates+=("$MAIN_CHECKOUT/.venv/bin/python" "$MAIN_CHECKOUT/.venv/Scripts/python.exe")
  fi
  candidates+=("${SYSTEM_PYTHONS[@]}")

  # Return the interpreter the probe actually ran (sys.executable), not the
  # candidate's name. A launcher can pick a DIFFERENT interpreter for a script than
  # for `-c`: the Windows `py` launcher honours a script's `#!/usr/bin/env python3`
  # shebang and runs the newest installed Python, while `py -c` runs its default.
  # Probing one interpreter and executing another let the probe pass and the
  # validators then fail with "Missing deps" (measured on Windows 11, 2026-10-14).
  local candidate exe
  for candidate in "${candidates[@]}"; do
    command -v "$candidate" >/dev/null 2>&1 || continue
    exe="$("$candidate" -c 'import sys, yaml; sys.version_info >= (3, 8) or sys.exit(1); print(sys.executable)' 2>/dev/null)" || continue
    exe="${exe%$'\r'}"
    if [[ -n "$exe" ]]; then
      printf '%s\n' "$exe"
      return 0
    fi
  done
  return 1
}

if ! PY="$(resolve_python)"; then
  echo
  echo "❌ pre-commit: no usable Python interpreter — commit ABORTED." >&2
  echo "   This is a MISSING DEPENDENCY, not a doc-validation finding." >&2
  echo "   The doc validators need PyYAML. Tried, in order:" >&2
  echo "     \$PYTHON        = ${PYTHON:-<unset>}" >&2
  echo "     repo venv      = $REPO_ROOT/.venv/bin/python, .venv/Scripts/python.exe" >&2
  if [[ -n "$MAIN_CHECKOUT" ]]; then
    echo "     main checkout  = $MAIN_CHECKOUT/.venv/{bin/python,Scripts/python.exe} (linked worktree)" >&2
  fi
  echo "     system         = ${SYSTEM_PYTHONS[*]} (Python 3.8+ with PyYAML)" >&2
  echo "   Fix: build the repo venv —" >&2
  echo "     uv venv && uv pip install -r requirements.txt" >&2
  echo "   or install PyYAML for your system Python 3." >&2
  exit 1
fi

fail=0

echo ">>> pre-commit: doc validation (see #678; skip with --no-verify)"

# All whole-tree + repo-wide — run on EVERY commit (unconditional). Running
# validate_docs every commit (not only when docs are staged) closes the gap
# where a frontmatter issue already in the tree slips past a code-only commit.
"$PY" tooling/scripts/validate_architecture_data.py --strict || fail=1
"$PY" tooling/scripts/validate_docs.py || fail=1

# Generated-file freshness (#987). frontmatter.schema.json and the status list
# in doc-standards.md are BUILD OUTPUT derived from allowed-values.json; both
# had already drifted from it before generation existed. --check writes nothing
# and fails if either is stale.
"$PY" tooling/scripts/generate_doc_standards.py --check || fail=1

if [[ "$fail" -ne 0 ]]; then
  echo
  echo "❌ pre-commit: doc validation failed — commit ABORTED."
  echo "   Fix the finding above (e.g. add a new doc_type to"
  echo "   docs/design/standards/allowed-values.json), then re-commit."
  echo "   If a generated file is STALE, regenerate it —"
  echo "     $PY tooling/scripts/generate_doc_standards.py"
  echo "   Bypass with 'git commit --no-verify' only if you are certain."
  exit 1
fi

echo "✓ pre-commit: doc validation passed."
