#!/usr/bin/env bash
# Block commits when charter JSON is out of sync
set -euo pipefail
FILE="docs/strategy/strategic_acceleration_charter.md"
if [ -f "$FILE" ]; then
  python tooling/scripts/kg_sync_docs.py "$FILE" --check || {
    echo "\n[pre-commit] JSON manifest is out of sync with $FILE" >&2
    echo "Run: python tooling/scripts/kg_sync_docs.py $FILE --write" >&2
    exit 1
  }
fi
